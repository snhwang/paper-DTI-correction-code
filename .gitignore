__pycache__/
*.pyc
*.csv
*.txt
!requirements.txt
*.log
.venv/

# Results are ignored by default, which is what keeps a locally generated
# HCP-A table from being committed by accident. The derived values that
# may be redistributed are listed back in one by one, so adding a file
# here is a deliberate act.
